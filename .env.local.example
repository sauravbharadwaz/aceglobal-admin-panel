# Supabase — find these in your project at:
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVICE ROLE key (secret!) — required for Team invites AND client portal invites.
# Bypasses RLS; NEVER expose in the browser. Same project as above.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Where the client dashboard lives. Client portal invite / set-password emails
# link here (…/?setup=1). Defaults to https://app.aceglobal.ai if unset.
PORTAL_APP_URL=https://app.aceglobal.ai

# Transactional email (Resend) — progress updates and invoice emails.
# Without this the app still works: the in-app notification is created, the
# email is skipped, and the save warns "Client email not sent".
# Key: resend.com/api-keys
RESEND_API_KEY=re_your-resend-key

# Sender address. Optional — defaults to
# "Ace Global <notifications@updates.aceglobal.ai>", which is a Resend-verified
# domain. Only set this to use a different verified sender.
# NOTIFY_EMAIL_FROM=Ace Global <notifications@updates.aceglobal.ai>

# Stripe secret key — needed to email a payable invoice link from the
# Invoices tab. Without it, creating invoices works but sending does not.
# Key: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_your-stripe-secret-key

# Copy this file to `.env.local` and fill in the values above, then restart `npm run dev`.
#
# These are LOCAL only. Production reads them from the Vercel project settings —
# adding a key here does not change the deployed app.
